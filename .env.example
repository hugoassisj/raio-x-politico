# Todas as variáveis são opcionais. Copie para .env.local e preencha as que quiser usar.

# Banco Postgres (Neon, Supabase ou qualquer Postgres 15+): busca textual e histórico de falas e resumos
DATABASE_URL=

# Resumos de IA com citações (pipeline:ai)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
AI_MODEL_LONG=claude-sonnet-5-5
AI_MAX_POLITICOS=80

# Todas as emendas parlamentares. Chave gratuita: https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
PORTAL_TRANSPARENCIA_API_KEY=

# Vídeos dos canais oficiais (YouTube Data API v3)
YOUTUBE_API_KEY=

# Publicações via APIs oficiais (pagas ou de acesso restrito)
X_BEARER_TOKEN=
IG_ACCESS_TOKEN=
IG_USER_ID=
TIKTOK_RESEARCH_TOKEN=

# Site
NEXT_PUBLIC_SITE_URL=https://raio-x-politico.vercel.app
NEXT_PUBLIC_REPO_URL=https://github.com/hugoassisj/raio-x-politico

# Desenvolvimento: ler dados de outra pasta (ex.: data-demo gerado por `npm run demo`)
DATA_DIR=
